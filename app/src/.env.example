###> APP ###

# The gateway application port
APP_PORT=6060

# The prefix for all API endpoints
APP_GLOBAL_PREFIX=/api

###< APP ###

###> SWAGGER ###

# The Swagger Doc title
SWAGGER_TITLE='NestJS Backend Template'

# The swagger path where the Swagger UI will be served
SWAGGER_PATH=/doc

###< SWAGGER ###

###> MONGO ###

# The MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/natiamigos-local

###< MONGO ###

###> CRYPTO ###

# Application-wide secret appended to values before hashing them (min 32 chars). Keep this out of version control in real environments.
CRYPTO_PEPPER=change-me-to-a-random-secret-of-at-least-32-characters

###< CRYPTO ###

###> AUTH ###

# API key required in the "x-api-key" header to access protected endpoints (min 32 chars). Keep this out of version control in real environments.
API_KEY=change-me-to-a-random-secret-of-at-least-32-characters

###< AUTH ###