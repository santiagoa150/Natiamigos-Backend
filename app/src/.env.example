###> APP ###

# The gateway application port
APP_PORT=6060

# The prefix for all API endpoints
APP_GLOBAL_PREFIX=/api

###< APP ###

###> SWAGGER ###

# The Swagger Doc title
SWAGGER_TITLE='NestJS Backend Template'

# The swagger path where the Swagger UI will be served
SWAGGER_PATH=/doc

###< SWAGGER ###

###> MONGO ###

# The MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/natiamigos-local

###< MONGO ###

###> CRYPTO ###

# Application-wide secret appended to values before hashing them (min 32 chars). Keep this out of version control in real environments.
CRYPTO_PEPPER=change-me-to-a-random-secret-of-at-least-32-characters

###< CRYPTO ###

###> AUTH ###

# API key required in the "x-api-key" header to access protected endpoints (min 32 chars). Keep this out of version control in real environments.
API_KEY=change-me-to-a-random-secret-of-at-least-32-characters

# Secret used to sign access tokens (min 32 chars). Must be different from JWT_REFRESH_TOKEN_SECRET. Keep this out of version control in real environments.
JWT_ACCESS_TOKEN_SECRET=change-me-to-a-random-secret-of-at-least-32-characters

# Secret used to sign refresh tokens (min 32 chars). Must be different from JWT_ACCESS_TOKEN_SECRET. Keep this out of version control in real environments.
JWT_REFRESH_TOKEN_SECRET=change-me-to-another-random-secret-of-at-least-32-characters

# Access token lifetime (zeit/ms format, e.g. "15m"). Must be shorter than JWT_REFRESH_TOKEN_EXPIRATION.
JWT_ACCESS_TOKEN_EXPIRATION=15m

# Refresh token lifetime (zeit/ms format, e.g. "7d"). Must be longer than JWT_ACCESS_TOKEN_EXPIRATION.
JWT_REFRESH_TOKEN_EXPIRATION=7d

###< AUTH ###